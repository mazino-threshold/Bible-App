# Copy this file to .env and fill in the values.

# Port the API listens on (Render sets this automatically in production)
PORT=4000

# development | production
NODE_ENV=development

# How much to log: error | warn | info | debug (default: debug in development, info in production)
LOG_LEVEL=

# Neon connection string: Neon dashboard -> your project -> Connect -> copy the URL
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full
# (Neon gives you sslmode=require; change it to verify-full to silence a warning from the pg library)
DATABASE_URL=

# How login codes are sent: console | brevo | resend
#   console = print to the terminal (development only, no account needed)
#   brevo   = no domain needed; verify a single sender email in Brevo
#   resend  = needs a domain verified in Resend
EMAIL_PROVIDER=console

# Name and address emails come from. For brevo, the address must be a sender verified in Brevo.
EMAIL_FROM_NAME=Brethren Bible Reading Club
EMAIL_FROM_ADDRESS=

# Brevo: Settings -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=

# Resend (for later, once you have a domain)
RESEND_API_KEY=

# Secret the cron job sends (header X-Cron-Secret) to trigger reminders. Required in production, 16+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty in development to allow triggering without it.
CRON_SECRET=

# Only if "Enhanced push security" is turned on in your Expo account (expo.dev -> Access tokens)
EXPO_ACCESS_TOKEN=
