# Copy this file to .env and fill in the values.

# Port the API listens on (Render sets this automatically in production)
PORT=4000

# development | production
NODE_ENV=development

# Neon connection string: Neon dashboard -> your project -> Connect -> copy the URL
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
