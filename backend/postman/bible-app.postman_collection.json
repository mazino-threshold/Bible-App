{
  "info": {
    "name": "Bible App API",
    "description": "Import into Postman, then edit the collection variables (email, name, phone).\n\nSign-in flow: run **Register** (first time) or **Request code**, put the 6-digit code from your email into the `code` variable, then run **Verify code**. The token is saved automatically and used by every signed-in request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "name", "value": "Your Name" },
    { "key": "email", "value": "you@example.com" },
    { "key": "phone", "value": "+234 803 000 0000" },
    { "key": "code", "value": "" },
    { "key": "token", "value": "" },
    { "key": "weekStart", "value": "2026-11-02", "description": "A Monday, YYYY-MM-DD" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('database ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('account created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Request code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/auth/request-code"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('code sent', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Verify code (saves token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}" },
            "url": "{{baseUrl}}/auth/verify-code"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('Token saved. Signed in as', body.user.email, '(' + body.user.role + ')');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (clears token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed out', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get my profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reminderFrequency\": \"high\"\n}" },
            "url": "{{baseUrl}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Schedule",
      "item": [
        {
          "name": "This week",
          "request": { "method": "GET", "url": "{{baseUrl}}/schedule/current" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('six days', () => pm.expect(pm.response.json().week.days).to.have.length(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "A specific week",
          "request": { "method": "GET", "url": "{{baseUrl}}/schedule/weeks/{{weekStart}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Check-ins",
      "item": [
        {
          "name": "My week (statuses + streak)",
          "request": { "method": "GET", "url": "{{baseUrl}}/check-ins/week" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const w = pm.response.json().week;",
                  "console.log('Today', w.today, '| read', w.daysRead + '/6', '| streak', w.streak);"
                ]
              }
            }
          ]
        },
        {
          "name": "Check in today",
          "request": { "method": "POST", "url": "{{baseUrl}}/check-ins/today" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('checked in', () => pm.expect(pm.response.json().checkedIn).to.eql(true));"]
              }
            }
          ]
        },
        {
          "name": "Untick today",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/check-ins/today" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('unticked', () => pm.expect(pm.response.json().checkedIn).to.eql(false));"]
              }
            }
          ]
        },
        {
          "name": "A specific week",
          "request": { "method": "GET", "url": "{{baseUrl}}/check-ins/weeks/{{weekStart}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin: Schedule",
      "description": "Requires signing in as an admin (npm run make-admin -- your@email.com).",
      "item": [
        {
          "name": "List scheduled weeks",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/schedule/weeks" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Save a week",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monday\":    { \"passage\": \"Genesis 1-3\" },\n  \"tuesday\":   { \"passage\": \"Genesis 4-6\" },\n  \"wednesday\": { \"passage\": \"Genesis 7-9\" },\n  \"thursday\":  { \"passage\": \"Genesis 10-12\" },\n  \"friday\":    { \"passage\": \"Genesis 13-15\", \"notes\": \"Optional notes\" },\n  \"saturday\":  { \"passage\": \"Genesis 16-18\" }\n}"
            },
            "url": "{{baseUrl}}/admin/schedule/weeks/{{weekStart}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('saved', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
