{
  "info": {
    "name": "Bible App API",
    "description": "Import into Postman, then edit the collection variables (email, name, phone).\n\nSign-in flow: run **Register** (first time) or **Request code**, put the 6-digit code from your email into the `code` variable, then run **Verify code**. The token is saved automatically and used by every signed-in request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "name", "value": "Your Name" },
    { "key": "email", "value": "you@example.com" },
    { "key": "phone", "value": "+234 803 000 0000" },
    { "key": "code", "value": "" },
    { "key": "token", "value": "" },
    { "key": "weekStart", "value": "2026-11-02", "description": "A Monday, YYYY-MM-DD" },
    { "key": "pushToken", "value": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]" },
    { "key": "cronSecret", "value": "", "description": "CRON_SECRET from .env (leave empty in development if not set)" },
    { "key": "userId", "value": "", "description": "The user to deactivate / reactivate (from List users)" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('database ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('account created', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Request code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/auth/request-code"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('code sent', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Verify code (saves token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}" },
            "url": "{{baseUrl}}/auth/verify-code"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('Token saved. Signed in as', body.user.email, '(' + body.user.role + ')');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (clears token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed out', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get my profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reminderFrequency\": \"high\"\n}" },
            "url": "{{baseUrl}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Schedule",
      "item": [
        {
          "name": "This week",
          "request": { "method": "GET", "url": "{{baseUrl}}/schedule/current" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('six days', () => pm.expect(pm.response.json().week.days).to.have.length(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "A specific week",
          "request": { "method": "GET", "url": "{{baseUrl}}/schedule/weeks/{{weekStart}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Passages",
      "item": [
        {
          "name": "Today's Bible text (full chapters)",
          "request": { "method": "GET", "url": "{{baseUrl}}/passages/today" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has chapters and copyright', () => {",
                  "  const p = pm.response.json().passage;",
                  "  pm.expect(p.chapters.length).to.be.above(0);",
                  "  pm.expect(p.version.copyright).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Check-ins",
      "item": [
        {
          "name": "My week (statuses + streak)",
          "request": { "method": "GET", "url": "{{baseUrl}}/check-ins/week" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const w = pm.response.json().week;",
                  "console.log('Today', w.today, '| read', w.daysRead + '/6', '| streak', w.streak);"
                ]
              }
            }
          ]
        },
        {
          "name": "Check in today",
          "request": { "method": "POST", "url": "{{baseUrl}}/check-ins/today" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('checked in', () => pm.expect(pm.response.json().checkedIn).to.eql(true));"]
              }
            }
          ]
        },
        {
          "name": "Untick today",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/check-ins/today" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('unticked', () => pm.expect(pm.response.json().checkedIn).to.eql(false));"]
              }
            }
          ]
        },
        {
          "name": "A specific week",
          "request": { "method": "GET", "url": "{{baseUrl}}/check-ins/weeks/{{weekStart}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin: Schedule",
      "description": "Requires signing in as an admin (npm run make-admin -- your@email.com).",
      "item": [
        {
          "name": "List scheduled weeks",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/schedule/weeks" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Save a week",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monday\":    { \"passage\": \"Genesis 1-3\" },\n  \"tuesday\":   { \"passage\": \"Genesis 4-6\" },\n  \"wednesday\": { \"passage\": \"Genesis 7-9\" },\n  \"thursday\":  { \"passage\": \"Genesis 10-12\" },\n  \"friday\":    { \"passage\": \"Genesis 13-15\", \"notes\": \"Optional notes\" },\n  \"saturday\":  { \"passage\": \"Genesis 16-18\" }\n}"
            },
            "url": "{{baseUrl}}/admin/schedule/weeks/{{weekStart}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('saved', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Push & Reminders",
      "item": [
        {
          "name": "Register push token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{pushToken}}\"\n}" },
            "url": "{{baseUrl}}/me/push-tokens"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('registered', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Remove push token",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{pushToken}}\"\n}" },
            "url": "{{baseUrl}}/me/push-tokens"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('removed', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Run reminders (what the cron job calls)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Cron-Secret", "value": "{{cronSecret}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/internal/reminders/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const run = pm.response.json().run;",
                  "console.log(run.status, run.reason || '', '| hour', run.hour, '| sent', run.sent, 'of', run.devices);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run a specific slot now (development only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Cron-Secret", "value": "{{cronSecret}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"hour\": 6\n}" },
            "url": "{{baseUrl}}/internal/reminders/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Clear passage cache (what the Sunday cron job calls)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Cron-Secret", "value": "{{cronSecret}}" }],
            "url": "{{baseUrl}}/internal/passage-cache/clear"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin: Reports",
      "description": "Requires signing in as an admin.",
      "item": [
        {
          "name": "This week's report",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/reports/weekly/current" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().report;",
                  "console.log(r.weekStart, '|', r.summary.totalUsers, 'users |', r.summary.readEveryDay, 'read every day | avg', r.summary.averageDaysRead);"
                ]
              }
            }
          ]
        },
        {
          "name": "A week's report",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/reports/weekly/{{weekStart}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Read every day (minDays=6)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reports/weekly/{{weekStart}}?minDays=6",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reports", "weekly", "{{weekStart}}"],
              "query": [{ "key": "minDays", "value": "6" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Read 3 days or fewer (maxDays=3)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reports/weekly/{{weekStart}}?maxDays=3",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reports", "weekly", "{{weekStart}}"],
              "query": [{ "key": "maxDays", "value": "3" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin: Users",
      "description": "Requires signing in as an admin. Run List users, then put the person's id in the userId variable.",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.response.json().users.forEach((u) => console.log(u.id, '|', u.name, '|', u.active ? 'active' : 'deactivated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List deactivated users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?status=deactivated",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [{ "key": "status", "value": "deactivated" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Deactivate a user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Missed three weeks in a row\"\n}" },
            "url": "{{baseUrl}}/admin/users/{{userId}}/deactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('deactivated', () => pm.expect(pm.response.json().user.active).to.equal(false));"]
              }
            }
          ]
        },
        {
          "name": "Reactivate a user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Back from travel\"\n}" },
            "url": "{{baseUrl}}/admin/users/{{userId}}/reactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('reactivated', () => pm.expect(pm.response.json().user.active).to.equal(true));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
